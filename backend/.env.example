# Copy to backend/.env and adjust. Real environment variables override this file.
DATABASE_URL=postgres://careerpilot:careerpilot@localhost:5433/careerpilot
API_BIND_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://localhost:3000
RUST_LOG=careerpilot_api=debug,tower_http=info

# Daily SEEK scrape, in local time (24h). Set to "off" to only scrape from the UI.
SCRAPE_DAILY_AT=08:00
SCRAPE_TIMEZONE=Australia/Sydney

# Only needed once, for `cargo run -- import-supabase` (see the F2 guide).
# SUPABASE_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Relevance scoring with a local model (F3). Install Ollama, then `ollama pull qwen3:14b`.
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
# Your v1 resume, copied into the database on first start (then edit it on the Profile page).
RESUME_PATH=../data/master_resume.md

# Password vault key (F4). Create it with `cargo run -- vault-init`, which adds it to backend/.env.
# Back it up: without it, saved passwords can't be decrypted. Never commit it.
# VAULT_KEY=

# Browser apply (F6). Start the worker with `npm start` in browser-worker/.
BROWSER_WORKER_URL=http://127.0.0.1:8090

# Email codes (F6b): a Google Cloud OAuth client of type "Desktop app", with the
# Gmail API enabled. Read-only access. Then click Connect Gmail on Settings.
# Never commit the real values.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
